{
  "dxt_version": "0.2",
  "name": "clarative-mcp",
  "version": "0.0.5",
  "description": "The official MCP Server for the Clarative API",
  "author": {
    "name": "Clarative",
    "email": "support@clarative.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harbinger-labs/clarative-typescript.git"
  },
  "homepage": "https://github.com/harbinger-labs/clarative-typescript/tree/main/packages/mcp-server#readme",
  "documentation": "https://docs.clarative.ai/api",
  "server": {
    "type": "node",
    "entry_point": "index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/index.js"
      ],
      "env": {
        "CLARATIVE_API_KEY": "${user_config.CLARATIVE_API_KEY}"
      }
    }
  },
  "user_config": {
    "CLARATIVE_API_KEY": {
      "title": "api_key",
      "description": "",
      "required": true,
      "type": "string"
    }
  },
  "tools": [],
  "tools_generated": true,
  "compatibility": {
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "keywords": [
    "api"
  ]
}
